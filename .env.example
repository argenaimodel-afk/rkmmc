# Copy to .env and adjust (`.env` is gitignored; real environment variables win).

# Required in production:
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# Optional hardening (sane production defaults shown):
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000   # once the site is stable on HTTPS
# DJANGO_BEHIND_PROXY=1                 # only if TLS is terminated by a proxy (nginx etc.)

# For production mail, set in .env:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=RKMMC <no-reply@yourdomain.com>
# DJANGO_SUPPORT_EMAIL=support@yourdomain.com
# (SMTP host/port/credentials require a custom backend config or a mailer
#  entry with OPTIONS — see https://docs.djangoproject.com/en/6.1/topics/email/)
